# CPU usage per core
mpstat -P ALL 1

# Network statistics
sar -n DEV 1

# Active connections
watch -n 1 'ss -s'

# File descriptors
watch -n 1 'lsof -p $(pgrep -f optimized_server) | wc -l'

# Memory usage
watch -n 1 'ps aux | grep python'
```

